	(text "2/3"
		(exclude_from_sim no)
		(at 27.94 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "b6123b09-3743-4de8-b794-9cc20ab960c8")
	)
	(text "Нагрузка I_{н} = 7 мА; R1 и U_{вых} заданы, поэтому ток R1 не меняется:\nI_{R1} = (U_{вх} - U_{вых}) / R1,   I_{R2} = I_{R1} - I_{н},   R2 = U_{вых} / I_{R2}\nНа схемах нагрузка показана резистором R_{н} = U_{вых} / I_{н}"
		(exclude_from_sim no)
		(at 35.56 13.97 0)
		(effects
			(font
				(size 1.75 1.75)
			)
			(justify left top)
		)
		(uuid "ff294519-8bd8-4c5a-b2e9-df452697b435")
	)
	(text "Перерасчёт задачи 2.1 (R13 = 8,4 В / 7 мА = 1,2 кОм):\nI_{R11} = (12,7 - 8,4) В / 220 Ом = 19,55 мА\nI_{R12} = 19,55 мА - 7 мА = 12,55 мА\nR12 = 8,4 В / 0,01255 А = 669,6 Ом  =>  по E24: R12 = 680 Ом\nПроверка: U_{вых} = (U_{вх}/R11 - I_{н}) / (1/R11 + 1/R12) = 8,43 В\nP_{R11} = 0,083 Вт, P_{R12} = 0,105 Вт"
		(exclude_from_sim no)
		(at 80.01 34.29 0)
		(effects
			(font
				(size 1.75 1.75)
			)
			(justify left top)
		)
		(uuid "8d6412da-79fb-4d7c-aed7-34c88d232b55")
	)
	(text "Перерасчёт задачи 2.2 (R16 = 3,4 В / 7 мА = 486 Ом):\nI_{R14} = (6,8 - 3,4) В / 82 Ом = 41,46 мА\nI_{R15} = 41,46 мА - 7 мА = 34,46 мА\nR15 = 3,4 В / 0,03446 А = 98,7 Ом  =>  по E24: R15 = 100 Ом\nПроверка: U_{вых} = (U_{вх}/R14 - I_{н}) / (1/R14 + 1/R15) = 3,42 В\nP_{R14} = 0,139 Вт, P_{R15} = 0,117 Вт"
		(exclude_from_sim no)
		(at 80.01 74.93 0)
		(effects
			(font
				(size 1.75 1.75)
			)
			(justify left top)
		)
		(uuid "37a66137-a47d-4948-aafb-0db6dacd1ff3")
	)
