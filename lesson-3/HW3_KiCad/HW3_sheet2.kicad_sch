		(uuid "88580a08-7366-4163-b2a9-824e5c12498c")
	)
	(text "U_{C}(t) = U·(1 - e^{-t/τ}),  τ = R·C;   0,95 = 1 - e^{-t/τ}  =>  t = τ·ln 20 ≈ 3·R·C"
		(exclude_from_sim no)
		(at 35.56 127 0)
