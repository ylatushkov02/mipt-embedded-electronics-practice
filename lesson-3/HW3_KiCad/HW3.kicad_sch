		(uuid "ebe6aed9-6311-4d20-8c52-fa92234af9b5")
	)
	(text "I = U_{вх} / (R7 + R8),  U_{вых} = I·R8\nI = (U_{вх} - U_{вых}) / R7 = (12,7 - 8,4) В / 220 Ом = 19,5 мА\nR8 = R7·U_{вых} / (U_{вх} - U_{вых}) = 220 Ом · 8,4 В / 4,3 В = 429,8 Ом\nпо E24: R8 = 430 Ом;  проверка: U_{вых} = 12,7·430 / 650 = 8,40 В\nP_{R7} = 0,084 Вт, P_{R8} = 0,164 Вт  =>  0,25 Вт"
		(exclude_from_sim no)
		(at 72.39 152.4 0)
		(effects
			(font
				(size 1.75 1.75)
			)
			(justify left top)
		)
		(uuid "6562500e-5881-4178-96f1-ea33a4b67080")
	)
	(text "2/2"
		(exclude_from_sim no)
		(at 27.94 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "07cfeaea-aa40-4482-b9d9-938285fe0e5f")
	)
	(text "U_{вых} = U_{вх} / 2  =>  R10 = R9 = 82 Ом (есть в ряду E24)\nI = 6,8 В / (82 + 82) Ом = 41,5 мА\nP_{R9} = P_{R10} = 3,4 В · 0,0415 А = 0,141 Вт  =>  0,25 Вт"
		(exclude_from_sim no)
		(at 72.39 196.85 0)
		(effects
			(font
				(size 1.75 1.75)
			)
			(justify left top)
		)
		(uuid "9550ba3a-85a4-47e6-9009-f0ec00233389")
	)
