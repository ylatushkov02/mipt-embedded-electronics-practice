	(text "R1 = (U_{пит} - U_{VD}) / I_{VD} = (7,4 - 3,2) В / 0,02 А = 210 Ом  =>  по E24: R1 = 220 Ом\nБелый LED 5AW4UC: U_{VD} = 3,2 В (3,0...3,4 В), I_{VD} = 20 мА\nI = 4,2 В / 220 Ом = 19,1 мА\nP_{R1} = U_{R1}·I = 4,2 В · 0,0191 А = 0,080 Вт  =>  резистор 220 Ом, 0,125 Вт"
		(exclude_from_sim no)
		(at 72.39 15.24 0)
		(effects
			(font
				(size 1.75 1.75)
			)
			(justify left top)
		)
		(uuid "9c1e73f7-0f1f-49f0-a759-949b5172e5ad")
	)
	(text "1/2"
		(exclude_from_sim no)
		(at 27.94 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "e416b9e6-2f87-4473-9a0d-89bdf7af59a2")
	)
	(text "R2 = (U_{пит} - 2·U_{VD}) / I_{VD} = (11,7 - 2·2,1) В / 0,02 А = 375 Ом  =>  по E24: R2 = 390 Ом\nЗелёный LED MCL056YGW: U_{VD} = 2,1 В, I_{VD} = 20 мА\nI = 7,5 В / 390 Ом = 19,2 мА\nP_{R2} = U_{R2}·I = 7,5 В · 0,0192 А = 0,144 Вт  =>  резистор 390 Ом, 0,25 Вт"
		(exclude_from_sim no)
		(at 72.39 43.18 0)
		(effects
			(font
				(size 1.75 1.75)
			)
			(justify left top)
		)
		(uuid "6283b5cf-6783-48e0-a747-e82833f85c90")
	)
